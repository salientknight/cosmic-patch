+#[cfg(test)]
+mod tests {
+    use super::*;
+    use cosmic::iced::futures::{StreamExt, channel::mpsc};
+    use tokio::sync::mpsc::unbounded_channel;
+
+    #[tokio::test]
+    async fn pam_error_and_terminal_failure_produce_distinct_events() {
+        let _ = crate::localize::localizer();
+        let (client, mut server) = UnixStream::pair().unwrap();
+        let (requests, receiver) = unbounded_channel();
+        let (mut sender, mut events) = mpsc::channel(1);
+        let worker = tokio::spawn(async move {
+            serve(client, receiver, &mut sender, Duration::from_secs(2)).await
+        });
+
+        requests
+            .send(Request::CreateSession {
+                username: "alice".into(),
+            })
+            .unwrap();
+        assert!(matches!(
+            Request::read_from(&mut server).await.unwrap(),
+            Request::CreateSession { .. }
+        ));
+        Response::AuthMessage {
+            auth_message_type: AuthMessageType::Error,
+            auth_message: "Key timed out".into(),
+        }
+        .write_to(&mut server)
+        .await
+        .unwrap();
+        assert!(matches!(events.next().await, Some(Message::AuthNotice(_))));
+
+        requests
+            .send(Request::PostAuthMessageResponse { response: None })
+            .unwrap();
+        assert!(matches!(
+            Request::read_from(&mut server).await.unwrap(),
+            Request::PostAuthMessageResponse { response: None }
+        ));
+        Response::Error {
+            error_type: ErrorType::AuthError,
+            description: "AUTH_ERR".into(),
+        }
+        .write_to(&mut server)
+        .await
+        .unwrap();
+        assert!(matches!(
+            events.next().await,
+            Some(Message::AuthenticationFailed(_))
+        ));
+
+        requests.send(Request::CancelSession).unwrap();
+        assert!(matches!(
+            Request::read_from(&mut server).await.unwrap(),
+            Request::CancelSession
+        ));
+        Response::Success.write_to(&mut server).await.unwrap();
+        assert!(!worker.await.unwrap());
+        assert!(events.next().await.is_none());
+    }
+
+    #[tokio::test]
+    async fn unanswered_request_times_out_and_reconnects_with_a_fresh_channel() {
+        let path =
+            std::env::temp_dir().join(format!("cosmic-greeter-ipc-{}.sock", std::process::id()));
+        let listener = tokio::net::UnixListener::bind(&path).unwrap();
+        let (mut sender, mut events) = mpsc::channel(1);
+        let worker_path = path.clone();
+        let worker = tokio::spawn(async move {
+            run(&worker_path, &mut sender, Duration::from_millis(250)).await;
+        });
+
+        let result = time::timeout(Duration::from_secs(5), async {
+            assert!(matches!(events.next().await, Some(Message::Reconnect)));
+            let Some(Message::Socket(SocketState::Open(old_requests))) = events.next().await else {
+                panic!("expected the original connection");
+            };
+            let (mut first, _) = listener.accept().await.unwrap();
+            old_requests
+                .send(Request::CreateSession {
+                    username: "alice".into(),
+                })
+                .unwrap();
+            assert!(matches!(
+                Request::read_from(&mut first).await.unwrap(),
+                Request::CreateSession { .. }
+            ));
+
+            // Keep the original socket open without answering.
+            assert!(matches!(events.next().await, Some(Message::Reconnect)));
+            assert!(old_requests.is_closed());
+
+            let (mut recovered, _) = listener.accept().await.unwrap();
+            assert!(matches!(
+                Request::read_from(&mut recovered).await.unwrap(),
+                Request::CancelSession
+            ));
+            Response::Success.write_to(&mut recovered).await.unwrap();
+            let Some(Message::Socket(SocketState::Open(requests))) = events.next().await else {
+                panic!("expected the recovered connection");
+            };
+            requests
+                .send(Request::CreateSession {
+                    username: "bob".into(),
+                })
+                .unwrap();
+            assert!(matches!(
+                Request::read_from(&mut recovered).await.unwrap(),
+                Request::CreateSession { username } if username == "bob"
+            ));
+        })
+        .await;
+        worker.abort();
+        std::fs::remove_file(path).unwrap();
+        result.unwrap();
+    }
