+#[cfg(test)]
+mod tests {
+    use super::*;
+    use cosmic::Application;
+    use tokio::sync::mpsc::{self, UnboundedReceiver};
+
+    fn greeter() -> App {
+        let _ = crate::localize::localizer();
+        let (mut app, _) = App::init(
+            Core::default(),
+            Flags {
+                user_datas: vec![],
+                user_icons: vec![],
+                sessions: HashMap::new(),
+                greeter_config: CosmicGreeterConfig::default(),
+                greeter_config_handler: None,
+                logind_available: false,
+            },
+        );
+        app.selected_username.username = "alice".into();
+        app
+    }
+
+    fn open(app: &mut App) -> UnboundedReceiver<Request> {
+        let (sender, receiver) = mpsc::unbounded_channel();
+        let _ = app.update(Message::Socket(SocketState::Open(sender)));
+        receiver
+    }
+
+    #[test]
+    fn pam_notices_are_acknowledged_and_allow_password_fallback() {
+        let mut app = greeter();
+        let mut requests = open(&mut app);
+        assert!(matches!(
+            requests.try_recv().unwrap(),
+            Request::CreateSession { username } if username == "alice"
+        ));
+
+        for notice in ["Touch the security key", "Security key timed out"] {
+            let _ = app.update(Message::AuthNotice(notice.into()));
+            assert!(matches!(
+                requests.try_recv().unwrap(),
+                Request::PostAuthMessageResponse { response: None }
+            ));
+        }
+        let _ = app.update(Message::AuthPrompt("Password".into(), true));
+        assert_eq!(app.authentication, Authentication::Prompt);
+        assert_eq!(
+            app.common.prompt_opt,
+            Some(("Password".into(), true, Some(String::new())))
+        );
+        let _ = app.update(Message::Auth("test password".into()));
+        assert!(matches!(
+            requests.try_recv().unwrap(),
+            Request::PostAuthMessageResponse { response: Some(response) } if response == "test password"
+        ));
+
+        let _ = app.update(Message::AuthNotice("Try again".into()));
+        assert!(matches!(
+            requests.try_recv().unwrap(),
+            Request::PostAuthMessageResponse { response: None }
+        ));
+    }
+
+    #[test]
+    fn automatic_authentication_can_start_a_session_without_input() {
+        let mut app = greeter();
+        app.flags
+            .sessions
+            .insert("desktop".into(), (vec!["desktop".into()], vec![]));
+        app.selected_session = "desktop".into();
+        let mut requests = open(&mut app);
+        assert!(matches!(
+            requests.try_recv().unwrap(),
+            Request::CreateSession { .. }
+        ));
+
+        let _ = app.update(Message::Login);
+        assert!(matches!(
+            requests.try_recv().unwrap(),
+            Request::StartSession { cmd, .. } if cmd == ["desktop"]
+        ));
+    }
+
+    #[test]
+    fn terminal_failure_requires_an_explicit_retry() {
+        let mut app = greeter();
+        let mut requests = open(&mut app);
+        let _ = requests.try_recv().unwrap();
+        let _ = app.update(Message::AuthNotice("Touch key".into()));
+        let _ = requests.try_recv().unwrap();
+
+        let _ = app.update(Message::AuthenticationFailed(
+            "Authentication failed".into(),
+        ));
+        assert!(app.common.prompt_opt.is_none());
+        assert_eq!(app.authentication, Authentication::Idle);
+        assert!(matches!(
+            requests.try_recv().unwrap(),
+            Request::CancelSession
+        ));
+
+        let _ = app.update(Message::Reconnect);
+        let mut requests = open(&mut app);
+        assert!(requests.is_empty());
+        assert_eq!(
+            app.common.error_opt.as_deref(),
+            Some("Authentication failed")
+        );
+        let _ = app.update(Message::RetryAuthentication);
+        let _ = app.update(Message::RetryAuthentication);
+        assert!(matches!(
+            requests.try_recv().unwrap(),
+            Request::CreateSession { .. }
+        ));
+        assert!(requests.is_empty());
+    }
+
+    #[test]
+    fn user_switch_cancels_and_starts_only_for_the_latest_selection() {
+        let mut app = greeter();
+        let mut requests = open(&mut app);
+        let _ = requests.try_recv().unwrap();
+        let _ = app.update(Message::Username("bob".into()));
+        let _ = app.update(Message::Username("carol".into()));
+
+        assert!(matches!(
+            requests.try_recv().unwrap(),
+            Request::CancelSession
+        ));
+        let _ = app.update(Message::AuthPrompt("Stale prompt".into(), true));
+        let _ = app.update(Message::AuthenticationFailed("Stale failure".into()));
+        assert!(app.common.prompt_opt.is_none());
+        assert!(app.common.error_opt.is_none());
+        let _ = app.update(Message::Reconnect);
+        let mut requests = open(&mut app);
+        assert!(matches!(
+            requests.try_recv().unwrap(),
+            Request::CreateSession { username } if username == "carol"
+        ));
+        assert!(requests.is_empty());
+    }
+
+    #[test]
+    fn disconnect_clears_prompt_and_manual_cancellation_stays_idle() {
+        let mut app = greeter();
+        let _requests = open(&mut app);
+        let _ = app.update(Message::AuthPrompt("Password".into(), true));
+        let _ = app.update(Message::Reconnect);
+        assert!(app.common.prompt_opt.is_none());
+        assert!(app.common.error_opt.is_some());
+
+        let mut requests = open(&mut app);
+        assert!(requests.is_empty());
+        let _ = app.update(Message::RetryAuthentication);
+        let _ = requests.try_recv().unwrap();
+        let _ = app.update(Message::CancelAuthentication);
+        assert!(matches!(
+            requests.try_recv().unwrap(),
+            Request::CancelSession
+        ));
+        let _ = app.update(Message::Reconnect);
+        assert!(open(&mut app).is_empty());
+    }
+}
