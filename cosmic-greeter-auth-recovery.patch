+                    let (requests, receiver) = mpsc::unbounded_channel();
+                    if sender
+                        .send(Message::Socket(SocketState::Open(requests)))
+                        .await
+                        .is_err()
+                    {
+                        return;
+                    }
+                    needs_cancel = serve(stream, receiver, sender, timeout).await;
+                    if sender.send(Message::Reconnect).await.is_err() {
+                        return;
+                    }
+                    if !needs_cancel {
+                        continue;
+                    }
+                }
+            }
+            Err(error) => {
+                tracing::warn!("greetd IPC socket connection failed: {error}");
+                if sender
+                    .send(Message::Socket(SocketState::Error(Arc::new(error))))
+                    .await
+                    .is_err()
+                {
+                    return;
+                }
+            }
         }
+        time::sleep(RECONNECT_DELAY).await;
     }
 }
 
