+// A lost socket can leave a session configured in greetd. Return whether the next
+// connection needs to cancel that session before it accepts requests from the UI.
+async fn serve(
+    mut stream: UnixStream,
+    mut requests: mpsc::UnboundedReceiver<Request>,
+    sender: &mut Sender<Message>,
+    timeout: Duration,
+) -> bool {
+    loop {
+        let mut unexpected = [0];
+        let request = tokio::select! {
+            request = requests.recv() => match request {
+                Some(request) => request,
+                None => return true,
+            },
+            // There are no unsolicited greetd messages. Watch for EOF even while
+            // the greeter is waiting for the user to answer a prompt.
+            result = stream.read(&mut unexpected) => {
+                tracing::warn!("greetd IPC socket closed or sent unexpected data: {result:?}");
+                return true;
+            }
+        };
+        match exchange(&mut stream, &request, timeout).await {
+            Ok(response) if matches!(request, Request::CancelSession) => {
+                if let Response::Error { description, .. } = response {
+                    tracing::warn!("error while cancelling greetd session: {description}");
+                }
+                return false;
+            }
+            Ok(response) => {
+                if sender
+                    .send(response_message(request, response))
+                    .await
+                    .is_err()
+                {
+                    return true;
+                }
+            }
+            Err(error) => {
+                tracing::warn!("greetd IPC request failed: {error:#}");
+                return true;
             }
         }
-        ErrorType::Error => {
-            // For generic errors, show a generic message
-            fl!("auth-error-default")
+    }
+}
