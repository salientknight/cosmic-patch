+fn response_message(request: Request, response: Response) -> Message {
+    match response {
+        Response::AuthMessage {
+            auth_message_type,
+            auth_message,
+        } => match auth_message_type {
+            AuthMessageType::Secret => Message::AuthPrompt(auth_message, true),
+            AuthMessageType::Visible => Message::AuthPrompt(auth_message, false),
+            AuthMessageType::Info | AuthMessageType::Error => Message::AuthNotice(auth_message),
+        },
+        Response::Error {
+            error_type,
+            description,
+        } => Message::AuthenticationFailed(greetd_error_to_message(error_type, &description)),
+        Response::Success if matches!(request, Request::StartSession { .. }) => Message::Exit,
+        Response::Success => Message::Login,
+    }
+}
